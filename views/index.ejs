<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full h-screen text-white p-10">
        <h3 class="text-3xl mb-5">Create Account</h3>
        <form action="/register" method="post">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-transparent rounded-lg" type="text" placeholder="name" name="name">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-transparent rounded-lg" type="text" placeholder="username" name="username">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-transparent rounded-lg" type="number" placeholder="age" name="age">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-transparent rounded-lg" type="text" placeholder="email" name="email">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-transparent rounded-lg" type="password" placeholder="password" name="password">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-purple-900 rounded-lg cursor-pointer" type="submit" value="Create Account">
            
        </form>

    </div>
</body>
</html>