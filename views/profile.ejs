<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full h-full text-white p-10">
        <div class="w-full flex justify-end ">
            <a class="bg-green-900 text-sm mb-5 inline-block rounded-lg px-3 py-2" href="/logout">Logout</a>

        </div>
        <h3 class="text-3xl mb-3"><span class="font-light">Hey</span>, <%= user.name %> </h3>
        <h5 class="mb-5" >you can create a post</h5>
        <form action="/post" method="post">
            <textarea placeholder="what's on your mind" class=" w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content" id=""></textarea>
            <input class="w-30 text-sm px-3 py-2 bg-purple-900 block rounded-lg mt-2" type="submit" value="Create new Post">
        </form>

        <div class="posts mt-20">
           <h3 class="text-zinc-500">Your Posts</h3>
           <div class="postcontainer mt-5">
             <% user.posts.forEach(function(post){ %>
                <div class="post mb-2 w-1/3 p-4 border-2 rounded-md bg-zinc-800 border-zinc-700 overflow-hidden">
                    <h4 class="text-blue-500 mb-2 ">    <%=user.username %>     </h4>
                    <p class="text-sm tracking-tight "> <%= post.content%>   </p>
                    <div class="btns flex gap-4 mt-5 overflow-hidden">
                        <a class="text-blue-500 " href="">Like</a>
                        <a class="text-purple-600" href="">Edit</a>
    
                    </div>
                </div>

             <%}) %>
           </div>
        </div>

    </div>
</body>
</html>