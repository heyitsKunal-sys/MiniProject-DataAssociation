<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full h-screen text-white p-10">
        <div class="w-full flex justify-end ">
            <a class="bg-green-900 text-sm mb-5 inline-block rounded-lg px-3 py-2" href="/logout">Logout</a>

        </div>
        
        <h5 class="mb-5" >Edit Your Post</h5>
        <form action="/update/<%=post._id %>" method="post">
            <textarea placeholder="what's on your mind" class=" w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content" id=""><%= post.content%></textarea>
            <input class="w-30 text-sm px-3 py-2 bg-red-900 block rounded-lg mt-2" type="submit" value="Update Post">
        </form>

       

    </div>
</body>
</html>